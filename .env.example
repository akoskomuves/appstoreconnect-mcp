# App Store Connect API credentials.
# Generate at https://appstoreconnect.apple.com/access/integrations/api
# Pricing writes need the Admin role; read-only operations work with App Manager.

# Issuer UUID from the Keys page
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# 10-character Key ID
ASC_KEY_ID=ABCDEF1234

# Path to your .p8 private key file. ~ is expanded.
# Keep this file outside any git working tree.
ASC_PRIVATE_KEY_PATH=~/.appstore/AuthKey_ABCDEF1234.p8
